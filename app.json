{
  "expo": {
    "name": "VIP Video Editor Pro",
    "slug": "my-expo-video-editor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#121212"
    },
    "android": {
      "package": "com.trongmanh.myexpovideoeditor",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập thư viện để chọn video và hình ảnh ghép."
        }
      ]
    ]
  }
}
