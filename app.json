{
  "expo": {
    "name": "VIP Video Studio",
    "slug": "my-expo-video-editor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0d0f12"
    },
    "android": {
      "package": "com.trongmanh.myexpovideoeditor",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập thư viện để chọn video chỉnh sửa."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Ứng dụng cần quyền lưu video đã xuất vào bộ nhớ máy.",
          "savePhotosPermission": "Ứng dụng cần quyền lưu video đã xuất vào bộ nhớ máy."
        }
      ]
    ]
  }
}
