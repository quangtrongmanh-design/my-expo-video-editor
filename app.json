{
  "expo": {
    "name": "VIP Video Studio",
    "slug": "my-expo-video-editor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.vipvideostudio.editor",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép ứng dụng lưu video vào Thư viện của bạn.",
          "savePhotosPermission": "Cho phép ứng dụng lưu video vào Thư viện của bạn."
        }
      ]
    ]
  }
}
